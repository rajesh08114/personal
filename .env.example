# ── Client (build time: Next.js bakes NEXT_PUBLIC_* into the browser bundle) ─────────────────────────────────────────
# Optional. When set, birthdays are published to this API instead of staying in
# the browser (IndexedDB). Use /api with the bundled server (`npm run start`),
# or an absolute URL for a separate API. See README "Server mode".
NEXT_PUBLIC_BIRTHDAY_API_URL=

# Optional. Uncaught errors are POSTed here as JSON (name, message, stack, path).
# No birthday content is ever included. /api/errors logs them on the bundled server.
NEXT_PUBLIC_ERROR_REPORT_URL=

# Optional. Shown on /privacy for questions and takedown requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Server (runtime, read by the Next.js server) ───────────────────────────
# PUBLIC_ORIGIN=https://birthday.example.com   # required in production
# PORT=8787
# DATA_DIR=./data                              # birthdays + uploaded media; mount a persistent volume
# MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net   # use MongoDB instead of DATA_DIR:
#                                              # birthdays in a collection, photos and songs in GridFS
# MONGODB_DB=birthday_studio                   # defaults to the database named in MONGODB_URI
# CORS_ORIGINS=                                # extra origins allowed to call the API (comma-separated)
# TRUST_PROXY=0                                # 1 behind a reverse proxy / load balancer (uses X-Forwarded-For)
# RATE_LIMIT_READ=120  RATE_LIMIT_WRITE=20  RATE_LIMIT_UPLOAD=60   # requests per minute per IP
# ORPHAN_MEDIA_HOURS=24                        # unreferenced uploads are deleted after this long
