# ==============================================================================
# BIRTHDAY STUDIO - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# QUICK START PRESETS:
# ------------------------------------------------------------------------------
# 1) Local Development with Auth (No MongoDB needed!):
#    NEXT_PUBLIC_BIRTHDAY_API_URL=/api
#    ACCOUNTS=memory
#    EMAIL=log
#    PUBLIC_ORIGIN=http://localhost:3000
#
# 2) Production (Docker / Cloud / MongoDB):
#    NEXT_PUBLIC_BIRTHDAY_API_URL=/api
#    PUBLIC_ORIGIN=https://birthday.example.com
#    MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
#    MONGODB_DB=birthday_studio
#    RESEND_API_KEY=re_123456789
#    EMAIL_FROM="Birthday Studio <hello@birthday.example.com>"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT SETTINGS (Baked into browser bundle at build time via Next.js)
# ------------------------------------------------------------------------------

# API Endpoint for Birthday Studio
# - Set to `/api` to use the built-in server (enables database, user accounts, sharing).
# - Leave blank to run purely offline in the user's browser (IndexedDB storage).
NEXT_PUBLIC_BIRTHDAY_API_URL=/api

# Optional support / contact email shown on the /privacy page for user inquiries.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional endpoint to collect unhandled client-side runtime errors as JSON.
# Leave blank to disable client error forwarding.
NEXT_PUBLIC_ERROR_REPORT_URL=


# ------------------------------------------------------------------------------
# 2. SERVER & CORE RUNTIME
# ------------------------------------------------------------------------------

# Canonical public origin of your website (used for open graph links, sharing, media URLs).
# - Development: http://localhost:3000 (or http://localhost:8787 for standalone server)
# - Production: https://birthday.yourdomain.com (REQUIRED in production)
PUBLIC_ORIGIN=http://localhost:3000

# Network port and host binding for the backend server
PORT=8787
HOST=0.0.0.0

# Directory where birthdays and uploaded images/music are saved when MongoDB is not used.
# (Mount a persistent volume here in Docker if not using MongoDB).
DATA_DIR=./data


# ------------------------------------------------------------------------------
# 3. DATABASE (MongoDB & GridFS Media Storage)
# ------------------------------------------------------------------------------

# MongoDB connection string. When provided, birthdays are stored in MongoDB collections
# and uploaded media (photos, audio) is stored in GridFS instead of DATA_DIR.
# Examples:
#   mongodb://localhost:27017
#   mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net
MONGODB_URI=

# Database name in MongoDB (defaults to the database named in MONGODB_URI or "birthday_studio")
MONGODB_DB=birthday_studio


# ------------------------------------------------------------------------------
# 4. USER ACCOUNTS & AUTHENTICATION
# ------------------------------------------------------------------------------

# Storage engine for accounts and sessions:
# - "mongodb" : Stores accounts in MongoDB (default when MONGODB_URI is provided)
# - "memory"  : Stores accounts in memory (great for quick dev/testing without MongoDB; resets on restart)
# - "off"     : Disables user accounts, logins, and private dashboard (runs in anonymous studio mode)
ACCOUNTS=memory

# Allow new visitors to create accounts ("open" or "closed")
REGISTRATION=open

# Duration in days before a user session cookie expires
SESSION_DAYS=30

# Maximum number of birthday projects a single user can create
MAX_WORKS_PER_USER=50

# Maximum storage quota in Megabytes (MB) for a user's uploaded media library
MAX_LIBRARY_MB=200


# ------------------------------------------------------------------------------
# 5. EMAIL SERVICE (Password Reset & Address Verification via Resend)
# ------------------------------------------------------------------------------

# Email delivery mode:
# - "resend" : Sends live emails via Resend API (requires RESEND_API_KEY and EMAIL_FROM)
# - "log"    : Development mode - writes verification & password reset links directly to server console
# - "off"    : Disables outgoing emails entirely
EMAIL=log

# Resend API key (get one from https://resend.com)
# When provided, EMAIL automatically defaults to "resend"
RESEND_API_KEY=

# Sender address shown on outgoing emails (Domain must be verified in Resend)
# Required if RESEND_API_KEY is set.
# Example: "Birthday Studio <hello@birthday.example.com>"
EMAIL_FROM=

# Link expiration windows
RESET_LINK_MINUTES=60
VERIFY_LINK_HOURS=24

# Email anti-abuse rate limits
RATE_LIMIT_EMAIL_PER_HOUR=3
RATE_LIMIT_EMAIL_IP_PER_HOUR=10
EMAIL_DAILY_LIMIT=500


# ------------------------------------------------------------------------------
# 6. SECURITY, REVERSE PROXY & RATE LIMITS
# ------------------------------------------------------------------------------

# Set to 1 (or true) if running behind a reverse proxy / load balancer (e.g. Cloudflare, Nginx, AWS ALB)
# to trust X-Forwarded-For and X-Forwarded-Proto headers.
TRUST_PROXY=0

# Additional allowed CORS origins (comma-separated). The app's own origin is always allowed.
CORS_ORIGINS=

# API Rate Limits (requests per minute per IP address)
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=20
RATE_LIMIT_UPLOAD=60
RATE_LIMIT_AUTH=10

# Media cleanup: Unreferenced uploaded files are automatically deleted after this many hours
ORPHAN_MEDIA_HOURS=24

# Upload size limits (in bytes)
# Defaults: JSON = 512 KB, Images = 8 MB, Audio = 13 MB
MAX_JSON_BYTES=524288
MAX_IMAGE_BYTES=8388608
MAX_AUDIO_BYTES=13631488
